# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略）

# 站点 URL —— 影响 sitemap.xml / robots.txt / JSON-LD
NUXT_PUBLIC_SITE_URL=https://your-domain
# Twikoo 评论后端地址（Cloudflare Worker URL）；为空则文章页不渲染评论区
NUXT_PUBLIC_COMMENT_ENV_ID=https://twikoo-cloudflare.xxx.workers.dev

# 部署：代码 push 到 GitHub 后由 Cloudflare Pages 自动构建上线（见 ./deploy.sh）
# 可选，默认推到名为 github 的远程；改名时覆盖即可
# DEPLOY_GIT_REMOTE=github

# 阿里云 OSS 静态站发布（AccessKey 不要写入本文件，使用 ossutil config）
# ALIYUN_OSS_BUCKET=duan-site-cn
# OSS_REGION=cn-hangzhou
# 使用阿里云 CLI OAuth 时设置；无需保存长期 AccessKey
# ALIYUN_CLI_PROFILE=codex-oss
# OSSUTIL_PROFILE=default
# ./deploy.sh 默认同时发布 GitHub/Cloudflare 与 OSS；设为 0 可临时跳过 OSS
# DEPLOY_OSS=1
# 仅此分支发布到 OSS，避免 preview 分支覆盖正式静态站
# OSS_DEPLOY_BRANCH=main
# 设为 1 时删除 OSS 中本地已不存在的文件；建议先为 Bucket 开启版本控制
# OSS_DELETE_STALE=0
